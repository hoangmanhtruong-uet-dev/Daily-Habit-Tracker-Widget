<Window
    x:Class="HabitGrid.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HabitGrid.WinUI.Controls">

    <Grid x:Name="Root">
        <!-- Nền canvas + đốm màu trôi, nằm dưới mọi thứ -->
        <controls:GradientBackdrop x:Name="Backdrop" />

        <Grid RowDefinitions="Auto,*">
            <!-- Thanh tiêu đề trong suốt (kéo được). Nút hệ thống ở góc phải do Windows vẽ. -->
            <Grid x:Name="TitleBar" Height="48" ColumnDefinitions="Auto,*,Auto" Padding="22,0,150,0" ColumnSpacing="12">
                <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource AccentGradientBrush}"
                        VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="2" Background="#CCFFFFFF"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" />
                </Border>
                <TextBlock Grid.Column="1" x:Name="TitleText" VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayBoldFont}" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <Border Grid.Column="2" x:Name="StreakChip" Visibility="Collapsed" VerticalAlignment="Center"
                        CornerRadius="{StaticResource RadiusPill}" Padding="12,5"
                        Background="{StaticResource CardIdleBrush}" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="1">
                    <TextBlock x:Name="StreakChipText" FontFamily="{StaticResource DisplayBoldFont}" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                <controls:IconRail x:Name="Rail" />
                <Frame Grid.Column="1" x:Name="ContentFrame" />
            </Grid>
        </Grid>
    </Grid>
</Window>
