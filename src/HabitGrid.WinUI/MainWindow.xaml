<Window
    x:Class="HabitGrid.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" RowDefinitions="Auto,*">

        <!-- Thanh tiêu đề tùy biến (kéo được) -->
        <Grid x:Name="TitleBar" Height="40" ColumnDefinitions="Auto,*" Padding="14,0,0,0" ColumnSpacing="10">
            <Border Width="18" Height="18" CornerRadius="5" Background="{ThemeResource AccentBrandBrush}"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="TitleText" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView Grid.Row="1" x:Name="Nav" PaneDisplayMode="Left" OpenPaneLength="220"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True" SelectionChanged="OnSelectionChanged">
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
