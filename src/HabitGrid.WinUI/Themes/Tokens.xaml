<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Token "Glow 2" (docs/v2/03-UI-REBUILD-GLOW2.md §4, §8).
        Các brush dưới đây là ĐỐI TƯỢNG DUY NHẤT; ThemeService đổi màu của chính chúng lúc chạy,
        nên đổi theme có hiệu lực ngay cả với tham chiếu StaticResource, không cần khởi động lại.
        Giá trị mặc định = Candy Bento (tối).
    -->

    <SolidColorBrush x:Key="CanvasBrush" Color="#0E0E14" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#1F1F2B" />
    <SolidColorBrush x:Key="StrokeSubtleBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="StrokeHighlightBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7F7FB" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B4B4C6" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7C7C92" />
    <SolidColorBrush x:Key="AccentBrandBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="CardIdleBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="HeatEmptyBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="FreezeBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="RailBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="RailSelectedTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OnGradientBrush" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0" />
        <GradientStop Color="#EC4899" Offset="1" />
    </LinearGradientBrush>

    <!-- Chữ -->
    <FontFamily x:Key="DisplayFont">ms-appx:///Assets/Fonts/BeVietnamPro-ExtraBold.ttf#Be Vietnam Pro</FontFamily>
    <FontFamily x:Key="DisplayBoldFont">ms-appx:///Assets/Fonts/BeVietnamPro-Bold.ttf#Be Vietnam Pro</FontFamily>
    <FontFamily x:Key="DisplaySemiBoldFont">ms-appx:///Assets/Fonts/BeVietnamPro-SemiBold.ttf#Be Vietnam Pro</FontFamily>

    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="LineHeight" Value="46" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="TitleDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayBoldFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="NumberXLTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="52" />
        <Setter Property="LineHeight" Value="56" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplaySemiBoldFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="BodySecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- Bo góc -->
    <CornerRadius x:Key="RadiusSm">10</CornerRadius>
    <CornerRadius x:Key="RadiusMd">16</CornerRadius>
    <CornerRadius x:Key="RadiusLg">28</CornerRadius>
    <CornerRadius x:Key="RadiusXl">32</CornerRadius>
    <CornerRadius x:Key="RadiusPill">19</CornerRadius>

    <!-- Thẻ / tile -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardIdleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="20,16" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayBoldFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Margin" Value="4,24,0,10" />
    </Style>

</ResourceDictionary>
