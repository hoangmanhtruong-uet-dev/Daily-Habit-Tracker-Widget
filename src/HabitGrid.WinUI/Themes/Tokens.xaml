<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design tokens "Glow" (docs/v2/01-DESIGN-SYSTEM.md). Chỉ dùng token, không viết mã màu cứng trong trang. -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AccentBrandColor">#6C5CE7</Color>
            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="Surface2Color">#F0F0F5</Color>
            <Color x:Key="StrokeSubtleColor">#14000000</Color>
            <Color x:Key="SuccessColor">#16A34A</Color>
            <Color x:Key="WarningColor">#D97706</Color>
            <Color x:Key="FreezeColor">#0EA5E9</Color>
            <Color x:Key="HeatEmptyColor">#EBEDF0</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AccentBrandColor">#8B7CFF</Color>
            <Color x:Key="SurfaceColor">#1C1C22</Color>
            <Color x:Key="Surface2Color">#26262E</Color>
            <Color x:Key="StrokeSubtleColor">#14FFFFFF</Color>
            <Color x:Key="SuccessColor">#22C55E</Color>
            <Color x:Key="WarningColor">#F59E0B</Color>
            <Color x:Key="FreezeColor">#38BDF8</Color>
            <Color x:Key="HeatEmptyColor">#2E2E38</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="AccentBrandColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="SurfaceColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="Surface2Color" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="StrokeSubtleColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="SuccessColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="WarningColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="FreezeColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="HeatEmptyColor" ResourceKey="SystemColorWindowColor" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="AccentBrandBrush" Color="{ThemeResource AccentBrandColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{ThemeResource Surface2Color}" />
    <SolidColorBrush x:Key="StrokeSubtleBrush" Color="{ThemeResource StrokeSubtleColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource WarningColor}" />
    <SolidColorBrush x:Key="FreezeBrush" Color="{ThemeResource FreezeColor}" />
    <SolidColorBrush x:Key="HeatEmptyBrush" Color="{ThemeResource HeatEmptyColor}" />

    <!-- Bo góc -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>
    <CornerRadius x:Key="RadiusXl">24</CornerRadius>

    <!-- Thẻ -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="4,20,0,8" />
    </Style>

</ResourceDictionary>
