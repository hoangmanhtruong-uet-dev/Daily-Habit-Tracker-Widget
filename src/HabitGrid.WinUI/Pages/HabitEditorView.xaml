<UserControl
    x:Class="HabitGrid.WinUI.Pages.HabitEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HabitGrid.WinUI"
    xmlns:vm="using:HabitGrid.Presentation.ViewModels">

    <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Padding="0,0,16,4" MinWidth="500" MaxWidth="560">

            <!-- Tên + icon hiện tại -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border x:Name="IconPreview" Width="48" Height="48" CornerRadius="14">
                    <TextBlock x:Name="IconPreviewText" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBox Grid.Column="1" x:Name="NameBox" MaxLength="40" VerticalAlignment="Center"
                         Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!-- Icon -->
            <StackPanel Spacing="6">
                <TextBlock x:Name="IconHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <GridView x:Name="EmojiGrid" SelectionMode="Single" Height="92" IsItemClickEnabled="False"
                          SelectionChanged="OnEmojiSelected" />
                <TextBox x:Name="CustomEmojiBox" MaxLength="8" Width="180" HorizontalAlignment="Left"
                         TextChanged="OnCustomEmojiChanged" />
            </StackPanel>

            <!-- Màu -->
            <StackPanel Spacing="6">
                <TextBlock x:Name="ColorHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <GridView x:Name="ColorGrid" SelectionMode="Single" Height="48" SelectionChanged="OnColorSelected" />
                <StackPanel Orientation="Horizontal" Spacing="4" x:Name="PreviewStrip" />
            </StackPanel>

            <!-- Loại -->
            <StackPanel Spacing="6">
                <TextBlock x:Name="KindHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <RadioButtons x:Name="KindRadio" MaxColumns="2" SelectionChanged="OnKindChanged" />
                <StackPanel x:Name="TargetPanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                    <NumberBox x:Name="TargetBox" Minimum="1" Maximum="100000" SpinButtonPlacementMode="Compact" Width="150" ValueChanged="OnTargetChanged" />
                    <TextBox x:Name="UnitBox" MaxLength="12" Width="150"
                             Text="{x:Bind ViewModel.Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>

            <!-- Tần suất -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="FrequencyHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="FrequencyBox" HorizontalAlignment="Stretch" SelectionChanged="OnFrequencyChanged" />

                <StackPanel x:Name="WeekDaysPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" />
                <NumberBox x:Name="TimesWeekBox" Minimum="1" Maximum="6" SpinButtonPlacementMode="Compact" Width="160"
                           HorizontalAlignment="Left" Visibility="Collapsed" ValueChanged="OnTimesWeekChanged" />
                <NumberBox x:Name="TimesMonthBox" Minimum="1" Maximum="27" SpinButtonPlacementMode="Compact" Width="160"
                           HorizontalAlignment="Left" Visibility="Collapsed" ValueChanged="OnTimesMonthChanged" />
                <NumberBox x:Name="IntervalBox" Minimum="2" Maximum="30" SpinButtonPlacementMode="Compact" Width="160"
                           HorizontalAlignment="Left" Visibility="Collapsed" ValueChanged="OnIntervalChanged" />
            </StackPanel>

            <!-- Khung giờ -->
            <StackPanel Spacing="6">
                <TextBlock x:Name="TimeOfDayHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="TimeOfDayBox" HorizontalAlignment="Stretch" SelectionChanged="OnTimeOfDayChanged" />
            </StackPanel>

            <!-- Nhắc nhở -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="RemindersHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel x:Name="RemindersPanel" Spacing="8" />
                <Button x:Name="AddReminderButton" Click="OnAddReminder" />
            </StackPanel>

            <!-- Nâng cao -->
            <Expander x:Name="AdvancedExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12" Padding="0,4,0,0">
                    <ToggleSwitch x:Name="MoodSwitch" IsOn="{x:Bind ViewModel.AskMood, Mode=TwoWay}" />
                    <ToggleSwitch x:Name="NotesSwitch" IsOn="{x:Bind ViewModel.AllowNotes, Mode=TwoWay}" />
                    <ToggleSwitch x:Name="FreezeSwitch" IsOn="{x:Bind ViewModel.AllowFreeze, Mode=TwoWay}" />
                    <TextBox x:Name="DescriptionBox" MaxLength="200" TextWrapping="Wrap" AcceptsReturn="True" Height="72"
                             Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox x:Name="TagsBox"
                             Text="{x:Bind ViewModel.TagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CalendarDatePicker x:Name="StartDatePicker" DateChanged="OnStartDateChanged" />
                </StackPanel>
            </Expander>

            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{ThemeResource WarningBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
