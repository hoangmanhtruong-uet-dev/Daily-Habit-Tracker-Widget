<Page
    x:Class="HabitGrid.WinUI.Pages.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HabitGrid.WinUI.Controls">

    <Grid RowDefinitions="*,Auto" Padding="40,24,40,24">

        <Grid Grid.Row="0" MaxWidth="820" HorizontalAlignment="Center" VerticalAlignment="Stretch">

            <!-- 1. Chào -->
            <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="520">
                <TextBlock Text="🌱" FontSize="88" HorizontalAlignment="Center" />
                <TextBlock x:Name="WelcomeTitle" Style="{StaticResource DisplayTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock x:Name="WelcomeBody" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="StartButton" Style="{StaticResource GradientButtonStyle}" HorizontalAlignment="Center"
                        Margin="0,12,0,0" Padding="28,10" Click="OnStartClick" />
                <HyperlinkButton x:Name="SkipButton" HorizontalAlignment="Center" Click="OnSkipClick" />
            </StackPanel>

            <!-- 2. Chủ đề -->
            <StackPanel x:Name="GoalsPanel" Visibility="Collapsed" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="GoalsTitle" Style="{StaticResource TitleDisplayTextStyle}" />
                <TextBlock x:Name="GoalsHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <GridView x:Name="TopicGrid" SelectionMode="None" Margin="0,12,0,0" />
                <InfoBar x:Name="GoalsInfo" Severity="Informational" IsOpen="False" IsClosable="True" />
            </StackPanel>

            <!-- 3. Thói quen -->
            <Grid x:Name="HabitsPanel" Visibility="Collapsed" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="HabitsTitle" Style="{StaticResource TitleDisplayTextStyle}" />
                    <TextBlock x:Name="HabitsHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <InfoBar Grid.Row="1" x:Name="HabitsInfo" Severity="Informational" IsOpen="False" IsClosable="True" />
                <Grid Grid.Row="2" ColumnDefinitions="3*,2*" ColumnSpacing="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <GridView x:Name="SuggestionGrid" SelectionMode="None" />
                    </ScrollViewer>
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                        <StackPanel Spacing="10">
                            <ItemsControl x:Name="PickedList" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox x:Name="CustomBox" MaxLength="40" KeyDown="OnCustomKeyDown" />
                                <Button Grid.Column="1" x:Name="CustomAddButton" Click="OnCustomAddClick" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 4. Buddy -->
            <StackPanel x:Name="BuddyPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="14" MaxWidth="460">
                <Border x:Name="BuddyBubble" Width="148" Height="148" CornerRadius="74" HorizontalAlignment="Center">
                    <TextBlock Text="🐣" FontSize="72" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="BuddyTitle" Style="{StaticResource TitleDisplayTextStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Name="BuddyBody" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBox x:Name="BuddyNameBox" MaxLength="20" TextChanged="OnBuddyNameChanged" />
                <GridView x:Name="BuddyColorGrid" SelectionMode="Single" HorizontalAlignment="Center"
                          SelectionChanged="OnBuddyColorSelected" />
            </StackPanel>

            <!-- 5. Nhắc nhở -->
            <StackPanel x:Name="ReminderPanel" Visibility="Collapsed" VerticalAlignment="Center" Spacing="10" MaxWidth="460"
                        HorizontalAlignment="Center">
                <TextBlock x:Name="ReminderTitle" Style="{StaticResource TitleDisplayTextStyle}" />
                <TextBlock x:Name="ReminderBody" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <controls:ChipGroup x:Name="ReminderRadio" Margin="0,8,0,0" MinChipWidth="150" SelectionChanged="OnReminderChanged" />
                <TimePicker x:Name="CustomTimePicker" ClockIdentifier="24HourClock" MinuteIncrement="5" Visibility="Collapsed"
                            TimeChanged="OnCustomTimeChanged" />
                <InfoBar x:Name="FinishError" Severity="Warning" IsOpen="False" IsClosable="True" />
            </StackPanel>
        </Grid>

        <!-- Thanh điều khiển -->
        <Grid x:Name="Footer" Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0" Visibility="Collapsed">
            <Button x:Name="BackButton" Click="OnBackClick" />
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="6" VerticalAlignment="Center">
                <StackPanel x:Name="Dots" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" />
                <TextBlock x:Name="StepText" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="2" x:Name="NextButton" Style="{StaticResource GradientButtonStyle}" Padding="24,8"
                    Click="OnNextClick" />
        </Grid>
    </Grid>
</Page>
