<Page
    x:Class="HabitGrid.WinUI.Pages.HabitsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HabitGrid.WinUI"
    xmlns:controls="using:HabitGrid.WinUI.Controls"
    xmlns:vm="using:HabitGrid.Presentation.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="36,28,36,16" RowDefinitions="Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleDisplayTextStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button x:Name="ChallengeButton" Click="OnChallengeClick" Style="{StaticResource GhostButtonStyle}" />
                <Button x:Name="RoutineButton" Click="OnRoutineClick" Style="{StaticResource GhostButtonStyle}" />
                <Button x:Name="AddButton" Click="OnAddClick" Style="{StaticResource GradientButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Name="AddButtonText" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
            <ToggleButton x:Name="ActiveChip" Style="{StaticResource ChipStyle}" IsChecked="True" Click="OnActiveChipClick" />
            <ToggleButton x:Name="ArchivedChip" Style="{StaticResource ChipStyle}" Click="OnArchivedChipClick" />
        </StackPanel>

        <GridView Grid.Row="2" x:Name="List" Margin="-6,12,-6,0" ItemsSource="{x:Bind ViewModel.Items}"
                  CanReorderItems="True" AllowDrop="True" SelectionMode="None" IsItemClickEnabled="False"
                  DragItemsCompleted="OnDragItemsCompleted">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin" Value="6" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="IsTabStop" Value="False" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:HabitListItem">
                    <controls:HabitCollectionCard Item="{x:Bind}" Width="272" ActionRequested="OnCardAction" />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel x:Name="EmptyPanel" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="10">
            <TextBlock Text="🌱" FontSize="56" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <InfoBar Grid.Row="3" x:Name="UndoBar" Severity="Informational" IsClosable="True" IsOpen="False">
            <InfoBar.ActionButton>
                <Button x:Name="UndoButton" Click="OnUndoDeleteClick" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Page>
