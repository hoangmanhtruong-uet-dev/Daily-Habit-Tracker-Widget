<Window x:Class="HabitGrid.UI.Widgets.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HabitGrid.UI.Controls"
        Title="HabitGrid"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="RootBorder"
            CornerRadius="12"
            Padding="10"
            Background="#F5F5F5"
            BorderBrush="#33808080"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: icon + tên + chip streak + nút hôm nay -->
            <Grid x:Name="HeaderGrid" Grid.Row="0" Background="Transparent" Cursor="SizeAll"
                  MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="IconText"
                           Grid.Column="0"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="15"
                           VerticalAlignment="Center"
                           Text="&#xE7C3;" />

                <TextBlock x:Name="HabitNameText"
                           Grid.Column="1"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />

                <Border x:Name="StreakChip"
                        Grid.Column="2"
                        Margin="0,0,4,0"
                        Padding="8,2"
                        CornerRadius="9"
                        Background="#22808080">
                    <TextBlock x:Name="StreakText"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </Border>

                <Button x:Name="TodayButton"
                        Grid.Column="3"
                        Width="26"
                        Height="26"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="13"
                        Content="&#xE73E;"
                        ToolTip="Đánh dấu hôm nay"
                        Click="OnTodayButtonClick" />
            </Grid>

            <!-- Lưới heatmap -->
            <controls:HeatmapGridControl x:Name="GridControl"
                                        Grid.Row="1"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top" />

            <!-- Lớp phủ chế độ chỉnh sửa: viền đứt + nút đóng -->
            <Grid Grid.Row="0" Grid.RowSpan="2" x:Name="EditModeLayer" Visibility="Collapsed">
                <Rectangle RadiusX="12" RadiusY="12"
                           Stroke="#60D97706"
                           StrokeThickness="1"
                           StrokeDashArray="4 3" />

                <Button x:Name="CloseWidgetButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-8,-8,0"
                        Width="20"
                        Height="20"
                        Padding="0"
                        BorderThickness="0"
                        Background="#E81123"
                        Foreground="White"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="10"
                        Content="&#xE711;"
                        ToolTip="Ẩn widget này"
                        Click="OnCloseWidgetClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
