<Window x:Class="HabitGrid.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HabitGrid.UI.Controls"
        xmlns:views="clr-namespace:HabitGrid.UI.Views"
        Title="HabitGrid"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="#E1E1E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#6E6E6E" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddHabitCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Delete" Command="{Binding ArchiveSelectedCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ CỘT TRÁI: DANH SÁCH THÓI QUEN ============ -->
        <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#E1E1E1" BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="HabitGrid" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border x:Name="PlanBadge"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Background="#0078D4"
                            CornerRadius="8"
                            Padding="7,2">
                        <TextBlock Text="FREE" FontSize="10" Foreground="White" />
                    </Border>
                </StackPanel>

                <Button Grid.Row="1"
                        x:Name="AddHabitButton"
                        Content="+  Thêm thói quen"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Padding="14,8"
                        Click="OnAddHabitClick" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="HabitList" ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="HabitCard"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Padding="6"
                                            Margin="0,2"
                                            MouseLeftButtonDown="OnHabitCardClick">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Tay nắm kéo để đổi thứ tự -->
                                            <TextBlock Grid.Column="0"
                                                       x:Name="DragHandle"
                                                       Text="≡"
                                                       FontSize="15"
                                                       Foreground="#9A9A9A"
                                                       VerticalAlignment="Center"
                                                       Cursor="SizeAll"
                                                       PreviewMouseLeftButtonDown="OnDragHandleMouseDown"
                                                       ToolTip="Giữ để đổi thứ tự" />

                                            <TextBlock Grid.Column="1"
                                                       Margin="6,0,8,0"
                                                       FontSize="15"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       Text="{Binding Icon.Glyph}" />

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StreakText}" FontSize="11" Foreground="#6E6E6E" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE72E;"
                                                           FontSize="12"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}"
                                                           ToolTip="Mở khóa Pro để chỉnh sửa thói quen này" />

                                                <Button x:Name="ToggleWidgetButton"
                                                        Content="&#xE7B3;"
                                                        FontSize="12"
                                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                        Padding="6,2"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Tag="{Binding Id}"
                                                        Click="OnToggleWidgetClick"
                                                        ToolTip="Bật/tắt widget trên desktop" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyStateText"
                                   Text="Chưa có thói quen nào.&#10;Bấm “+ Thêm thói quen” để bắt đầu."
                                   TextAlignment="Center"
                                   Foreground="#6E6E6E"
                                   Margin="0,32,0,0"
                                   Visibility="Collapsed" />

                        <StackPanel Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBlock Text="ĐÃ LƯU TRỮ" FontSize="11" Foreground="#6E6E6E" Margin="4,0,0,6" />
                            <ItemsControl x:Name="ArchivedList" ItemsSource="{Binding ArchivedItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Icon.Glyph}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Foreground="#6E6E6E" FontSize="13" />
                                            <Button Grid.Column="2" Content="↩" Background="Transparent" BorderThickness="0" Padding="6,2" Click="OnRestoreClick" Tag="{Binding Id}" ToolTip="Khôi phục" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Cài đặt" Click="OnSettingsClick" Margin="0,0,8,0" />
                    <Button Content="Nâng cấp Pro" Click="OnUpgradeClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ CỘT PHẢI: CHI TIẾT THÓI QUEN / CÀI ĐẶT ============ -->
        <Grid Grid.Column="1">
        <ScrollViewer x:Name="DetailScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="DetailPane" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header chi tiết -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="DetailIcon"
                           FontSize="22"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />

                <TextBlock Grid.Column="1"
                           x:Name="DetailName"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <Button Grid.Column="2" Content="Sửa" Margin="0,0,8,0" Click="OnEditHabitClick" />
                <Button Grid.Column="3" Content="Lưu trữ" Margin="0,0,8,0" Click="OnArchiveClick" />
                <Button Grid.Column="4" Content="Xóa" Click="OnDeleteClick" />
            </Grid>

            <!-- 4 thẻ chỉ số (WrapPanel để tự xuống hàng khi cửa sổ hẹp) -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,16">
                <Border Style="{StaticResource CardStyle}" Width="180" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Chuỗi hiện tại" Style="{StaticResource MetricLabelStyle}" Margin="0,0,0,0" />
                        <TextBlock x:Name="MetricStreak" Style="{StaticResource MetricValueStyle}" Text="—" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Width="180" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Kỷ lục" Style="{StaticResource MetricLabelStyle}" Margin="0,0,0,0" />
                        <TextBlock x:Name="MetricLongest" Style="{StaticResource MetricValueStyle}" Text="—" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Width="180" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Tỷ lệ 30 ngày" Style="{StaticResource MetricLabelStyle}" Margin="0,0,0,0" />
                        <TextBlock x:Name="MetricRate" Style="{StaticResource MetricValueStyle}" Text="—" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Width="180" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Tổng hoàn thành" Style="{StaticResource MetricLabelStyle}" Margin="0,0,0,0" />
                        <TextBlock x:Name="MetricTotal" Style="{StaticResource MetricValueStyle}" Text="—" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Lưới 52 tuần -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Lịch sử 52 tuần — bấm vào ô để sửa dữ liệu" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <controls:HeatmapGridControl x:Name="DetailGrid"
                                                    HorizontalAlignment="Left"
                                                    CellClicked="OnDetailCellClicked" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Biểu đồ 12 tháng -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Tỷ lệ hoàn thành 12 tháng" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                    <controls:MonthBarChart x:Name="MonthChart" Height="140" />
                </StackPanel>
            </Border>
        </Grid>
        </ScrollViewer>

        <views:SettingsView x:Name="SettingsPane" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
