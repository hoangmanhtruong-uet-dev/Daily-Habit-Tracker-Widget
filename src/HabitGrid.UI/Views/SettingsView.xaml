<UserControl x:Class="HabitGrid.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:HabitGrid.UI.Localization"
             xmlns:vm="clr-namespace:HabitGrid.UI.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource AppBackgroundBrush}"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,0,0">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <!-- ================= CHUNG ================= -->
            <GroupBox Header="{loc:Translate settings.general}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{loc:Translate settings.language}" />
                    <ComboBox x:Name="LanguageBox" Width="220" HorizontalAlignment="Left" Margin="0,4,0,0"
                              SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Tag="Vietnamese" Content="{loc:Translate settings.language.vi}" />
                        <ComboBoxItem Tag="English" Content="{loc:Translate settings.language.en}" />
                    </ComboBox>

                    <TextBlock Style="{StaticResource Label}" Text="{loc:Translate settings.weekStart}" Margin="0,14,0,0" />
                    <ComboBox x:Name="WeekStartBox" Width="220" HorizontalAlignment="Left" Margin="0,4,0,0"
                              SelectionChanged="OnWeekStartChanged">
                        <ComboBoxItem Tag="Monday" Content="{loc:Translate settings.weekStart.monday}" />
                        <ComboBoxItem Tag="Sunday" Content="{loc:Translate settings.weekStart.sunday}" />
                    </ComboBox>

                    <TextBlock Style="{StaticResource Label}" Text="{loc:Translate settings.dayCutoff}" Margin="0,14,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Slider x:Name="DayCutoffSlider" Width="240" Minimum="0" Maximum="5"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnDayCutoffChanged" />
                        <TextBlock x:Name="DayCutoffText" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource Label}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="{loc:Translate settings.dayCutoff.hint}" />

                    <CheckBox x:Name="RunAtStartupCheck" Margin="0,14,0,0"
                              Content="{loc:Translate settings.runAtStartup}"
                              Checked="OnRunAtStartupChanged" Unchecked="OnRunAtStartupChanged" />
                </StackPanel>
            </GroupBox>

            <!-- ================= GIAO DIỆN ================= -->
            <GroupBox Header="{loc:Translate settings.appearance}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{loc:Translate settings.theme}" />
                    <ComboBox x:Name="ThemeBox" Width="220" HorizontalAlignment="Left" Margin="0,4,0,0"
                              SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Tag="System" Content="{loc:Translate settings.theme.system}" />
                        <ComboBoxItem Tag="Light" Content="{loc:Translate settings.theme.light}" />
                        <ComboBoxItem Tag="Dark" Content="{loc:Translate settings.theme.dark}" />
                    </ComboBox>

                    <TextBlock Style="{StaticResource Label}" Text="{loc:Translate settings.backgroundStyle}" Margin="0,14,0,0" />
                    <ComboBox x:Name="BackgroundStyleBox" Width="260" HorizontalAlignment="Left" Margin="0,4,0,0"
                              SelectionChanged="OnBackgroundStyleChanged">
                        <ComboBoxItem Tag="Acrylic" Content="{loc:Translate settings.background.acrylic}" />
                        <ComboBoxItem Tag="Solid" Content="{loc:Translate settings.background.solid}" />
                        <ComboBoxItem Tag="None" Content="{loc:Translate settings.background.none}" />
                    </ComboBox>

                    <TextBlock Style="{StaticResource Label}" Text="{loc:Translate settings.opacity}" Margin="0,14,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Slider x:Name="OpacitySlider" Width="240" Minimum="0" Maximum="100"
                                ValueChanged="OnOpacityChanged" />
                        <TextBlock x:Name="OpacityText" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource Label}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Label}" Text="{loc:Translate settings.cornerRadius}" Margin="0,14,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Slider x:Name="CornerRadiusSlider" Width="240" Minimum="4" Maximum="16"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnCornerRadiusChanged" />
                        <TextBlock x:Name="CornerRadiusText" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource Label}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- ================= WIDGET ================= -->
            <GroupBox Header="{loc:Translate settings.widget}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{loc:Translate settings.pinning}" />
                    <ComboBox x:Name="PinningBox" Width="320" HorizontalAlignment="Left" Margin="0,4,0,0"
                              SelectionChanged="OnPinningChanged">
                        <ComboBoxItem Tag="0" Content="{loc:Translate settings.pinning.desktopLevel}" />
                        <ComboBoxItem Tag="1" Content="{loc:Translate settings.pinning.bottomMost}" />
                        <ComboBoxItem Tag="2" Content="{loc:Translate settings.pinning.alwaysOnTop}" />
                    </ComboBox>

                    <TextBlock Style="{StaticResource Label}" Text="{loc:Translate settings.defaultSize}" Margin="0,14,0,0" />
                    <ComboBox x:Name="DefaultSizeBox" Width="220" HorizontalAlignment="Left" Margin="0,4,0,0"
                              SelectionChanged="OnDefaultSizeChanged">
                        <ComboBoxItem Tag="0" Content="{loc:Translate settings.size.small}" />
                        <ComboBoxItem Tag="1" Content="{loc:Translate settings.size.medium}" />
                        <ComboBoxItem Tag="2" Content="{loc:Translate settings.size.large}" />
                    </ComboBox>

                    <CheckBox x:Name="EditModeCheck" Margin="0,14,0,0"
                              Content="{loc:Translate settings.editMode}"
                              Checked="OnEditModeChanged" Unchecked="OnEditModeChanged" />

                    <Button Content="{loc:Translate settings.resetPositions}" Margin="0,14,0,0"
                            HorizontalAlignment="Left" Click="OnResetPositionsClick" />
                </StackPanel>
            </GroupBox>

            <!-- ================= DU LIEU ================= -->
            <GroupBox Header="{loc:Translate settings.data}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="{loc:Translate settings.dataHint}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:Translate settings.dataFolder}" Click="OnOpenDataFolderClick" />
                        <Button x:Name="ExportJsonButton" Content="{loc:Translate settings.exportJson}"
                                Visibility="Collapsed" Click="OnExportJsonClick" />
                        <Button x:Name="ExportCsvButton" Content="{loc:Translate settings.exportCsv}"
                                Visibility="Collapsed" Click="OnExportCsvClick" />
                        <Button x:Name="ImportJsonButton" Content="{loc:Translate settings.importJson}"
                                Visibility="Collapsed" Click="OnImportJsonClick" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- ================= GIAP PHEP ================= -->
            <GroupBox Header="{loc:Translate settings.license}">
                <StackPanel>
                    <TextBlock x:Name="LicenseText" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="UpgradeButton" Content="{loc:Translate settings.upgrade}" Click="OnUpgradeClick" />
                        <Button Content="{loc:Translate settings.restorePurchase}" Click="OnUpgradeClick" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- ================= GIOI THIEU ================= -->
            <GroupBox Header="{loc:Translate settings.about}">
                <StackPanel>
                    <TextBlock x:Name="AppNameText" Style="{StaticResource Label}" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{loc:Translate settings.version}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                        <TextBlock x:Name="VersionText" Margin="8,0,0,0" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="{loc:Translate settings.copyVersion}" Margin="0,12,0,0"
                            HorizontalAlignment="Left" Click="OnCopyVersionClick" />
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
