<Window x:Class="HabitGrid.UI.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chào mừng đến với HabitGrid"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#F3F3F3"
        UseLayoutRounding="True">

    <StackPanel Margin="28">
        <TextBlock Text="Theo dõi thói quen tối giản ngay trên màn hình nền Windows của bạn."
                   FontSize="17"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6" />

        <TextBlock Text="Chọn một thói quen để bắt đầu — bạn luôn có thể thêm hoặc sửa sau."
                   FontSize="13"
                   Foreground="#6E6E6E"
                   TextWrapping="Wrap"
                   Margin="0,0,0,18" />

        <UniformGrid x:Name="SamplePanel" Columns="2" Margin="0,0,0,20" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Tự tạo thói quen riêng" Click="OnCustomClick" Margin="0,0,8,0" Padding="16,8" />
            <Button Content="Bắt đầu ngay" Click="OnSkipClick" IsDefault="True" Padding="20,8" FontWeight="SemiBold" />
        </StackPanel>
    </StackPanel>
</Window>
