<Window x:Class="HabitGrid.UI.Views.PaywallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nâng cấp HabitGrid Pro"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F3F3F3"
        UseLayoutRounding="True">

    <StackPanel Margin="28">
        <TextBlock Text="Mở khóa toàn bộ HabitGrid" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="ReasonText"
                   TextWrapping="Wrap"
                   Foreground="#6E6E6E"
                   FontSize="13"
                   Margin="0,8,0,18" />

        <!-- Lợi ích -->
        <Border Background="White" CornerRadius="12" BorderBrush="#E1E1E1" BorderThickness="1" Padding="16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="26" VerticalAlignment="Center" />
                    <TextBlock Text="Không giới hạn số thói quen" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="&#xE71E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="26" VerticalAlignment="Center" />
                    <TextBlock Text="Bảng màu heatmap tùy chỉnh theo ý bạn" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="26" VerticalAlignment="Center" />
                    <TextBlock Text="Xuất / nhập sao lưu JSON &amp; CSV" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Giá -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,4">
            <TextBlock Text="4,99 USD" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="  —  mua một lần, dùng mãi mãi" FontSize="12" Foreground="#6E6E6E" VerticalAlignment="Bottom" Margin="0,0,0,5" />
        </StackPanel>
        <TextBlock Text="Thanh toán an toàn qua Microsoft Store" FontSize="11" Foreground="#9A9A9A" HorizontalAlignment="Center" Margin="0,0,0,18" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Khôi phục giao dịch" Click="OnRestoreClick" Margin="0,0,8,0" Padding="16,7" />
            <Button x:Name="BuyButton" Content="Mở khóa Pro" Click="OnBuyClick" IsDefault="True" Padding="20,7" FontWeight="SemiBold" />
        </StackPanel>

        <TextBlock x:Name="StatusText" FontSize="12" Foreground="#C45511" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
