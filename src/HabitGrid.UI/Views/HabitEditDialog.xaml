<Window x:Class="HabitGrid.UI.Views.HabitEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HabitGrid.UI.Controls"
        Title="Thói quen"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F3F3F3"
        UseLayoutRounding="True">

    <StackPanel Margin="20">
        <!-- Tên -->
        <TextBlock Text="Tên thói quen" FontSize="12" Foreground="#6E6E6E" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" MaxLength="40" FontSize="14" Padding="8,6" />
        <TextBlock x:Name="NameHint" Text="Tối đa 40 ký tự" FontSize="11" Foreground="#9A9A9A" Margin="0,4,0,0" />

        <!-- Biểu tượng -->
        <TextBlock Text="Biểu tượng" FontSize="12" Foreground="#6E6E6E" Margin="0,16,0,4" />
        <controls:IconPicker x:Name="IconPicker" />

        <!-- Loại thói quen -->
        <TextBlock Text="Loại" FontSize="12" Foreground="#6E6E6E" Margin="0,16,0,4" />
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="BooleanOption" GroupName="Kind" Content="Đúng / Sai" IsChecked="True" Margin="0,0,16,0" Click="OnKindChanged" />
            <RadioButton x:Name="CountOption" GroupName="Kind" Content="Đếm số lượng" Click="OnKindChanged" />
        </StackPanel>

        <StackPanel x:Name="TargetPanel" Visibility="Collapsed" Margin="0,12,0,0">
            <TextBlock Text="Mục tiêu mỗi ngày" FontSize="12" Foreground="#6E6E6E" Margin="0,0,0,4" />
            <TextBox x:Name="TargetBox" Width="90" HorizontalAlignment="Left" FontSize="14" Padding="8,6" Text="8" />
        </StackPanel>

        <!-- Lịch lặp -->
        <TextBlock Text="Lịch lặp trong tuần" FontSize="12" Foreground="#6E6E6E" Margin="0,16,0,6" />
        <UniformGrid x:Name="SchedulePanel" Columns="7" Height="34">
            <ToggleButton x:Name="Day2" Content="T2" Tag="1" IsChecked="True" Click="OnScheduleChanged" Margin="2" />
            <ToggleButton x:Name="Day3" Content="T3" Tag="2" IsChecked="True" Click="OnScheduleChanged" Margin="2" />
            <ToggleButton x:Name="Day4" Content="T4" Tag="4" IsChecked="True" Click="OnScheduleChanged" Margin="2" />
            <ToggleButton x:Name="Day5" Content="T5" Tag="8" IsChecked="True" Click="OnScheduleChanged" Margin="2" />
            <ToggleButton x:Name="Day6" Content="T6" Tag="16" IsChecked="True" Click="OnScheduleChanged" Margin="2" />
            <ToggleButton x:Name="Day7" Content="T7" Tag="32" IsChecked="True" Click="OnScheduleChanged" Margin="2" />
            <ToggleButton x:Name="Day0" Content="CN" Tag="64" IsChecked="True" Click="OnScheduleChanged" Margin="2" />
        </UniformGrid>

        <!-- Bảng màu -->
        <TextBlock Text="Bảng màu heatmap" FontSize="12" Foreground="#6E6E6E" Margin="0,16,0,4" />
        <UniformGrid x:Name="PalettePanel" Columns="6" Height="34">
            <Button x:Name="PaletteDefault" Tag="default" Click="OnPaletteClick" Margin="2" Background="#30A14E" BorderThickness="0" ToolTip="Xanh lá (mặc định)" />
            <Button x:Name="PaletteBlue" Tag="blue" Click="OnPaletteClick" Margin="2" Background="#2F80D0" BorderThickness="0" ToolTip="Xanh dương" />
            <Button x:Name="PalettePurple" Tag="purple" Click="OnPaletteClick" Margin="2" Background="#8B4FD0" BorderThickness="0" ToolTip="Tím" />
            <Button x:Name="PaletteOrange" Tag="orange" Click="OnPaletteClick" Margin="2" Background="#F77F00" BorderThickness="0" ToolTip="Cam" />
            <Button x:Name="PalettePink" Tag="pink" Click="OnPaletteClick" Margin="2" Background="#E5508A" BorderThickness="0" ToolTip="Hồng" />
            <Button x:Name="PaletteGray" Tag="grayscale" Click="OnPaletteClick" Margin="2" Background="#707070" BorderThickness="0" ToolTip="Xám đơn sắc" />
        </UniformGrid>
        <TextBlock x:Name="PaletteHint" Text="Màu tùy chỉnh là tính năng Pro." FontSize="11" Foreground="#C45511" Margin="0,6,0,0" />

        <!-- Nhắc nhở -->
        <TextBlock Text="Nhắc nhở hằng ngày" FontSize="12" Foreground="#6E6E6E" Margin="0,16,0,4" />
        <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="ReminderCheck" Content="Nhắc tôi vào lúc" VerticalAlignment="Center" Margin="0,0,12,0" />
            <controls:TimeField x:Name="ReminderTime" />
        </StackPanel>

        <!-- Nút -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Hủy" Click="OnCancelClick" Margin="0,0,8,0" Padding="16,7" />
            <Button Content="Lưu" Click="OnSaveClick" IsDefault="True" Padding="20,7" FontWeight="SemiBold" />
        </StackPanel>
    </StackPanel>
</Window>
